{
  "$comment": "Format catalogue for the document converter (Module 2). Editable: the planner validates this file on load and falls back to the shipped copy if it is invalid. caps = what the format can hold: full (content and structure kept) | partial (content kept as plain text or appearance only, structure lost) | none (cannot be stored). sourceCaps overrides caps when the format is read as a source (e.g. text in a scan is recoverable only by OCR). transit=false means routes may start or end here but never pass through (stops detours such as PDF -> TXT -> HTML or HTML -> XLSX -> PDF/A). normalizeTo lets a legacy source pass through its modern equivalent (DOC -> DOCX -> ...). targetModes lists the fidelity modes that mean something for this target; a target with only 'exact' ignores the mode switch.",
  "features": {
    "text":            { "label": "Text",                "visual": true },
    "fonts":           { "label": "Fonts",               "visual": true },
    "images":          { "label": "Images",              "visual": true },
    "vector":          { "label": "Vector graphics",     "visual": true },
    "tables":          { "label": "Table structure",     "visual": true },
    "merged_cells":    { "label": "Merged cells",        "visual": true },
    "formulas":        { "label": "Formulas",            "visual": false },
    "number_formats":  { "label": "Number formats",      "visual": true },
    "hyperlinks":      { "label": "Hyperlinks",          "visual": false },
    "bookmarks":       { "label": "Bookmarks/TOC",       "visual": false },
    "headers_footers": { "label": "Headers/footers",     "visual": true },
    "footnotes":       { "label": "Footnotes",           "visual": true },
    "slide_notes":     { "label": "Speaker notes",       "visual": false },
    "metadata":        { "label": "Metadata",            "visual": false },
    "attachments":     { "label": "Attachments",         "visual": false }
  },
  "formats": {
    "pdf": {
      "short": "PDF", "label": "PDF", "ext": [".pdf"], "roles": ["source", "target"], "transit": true, "targetModes": ["exact"],
      "caps": { "text": "full", "fonts": "full", "images": "full", "vector": "full", "tables": "partial", "merged_cells": "partial", "formulas": "none", "number_formats": "partial", "hyperlinks": "full", "bookmarks": "full", "headers_footers": "partial", "footnotes": "partial", "slide_notes": "partial", "metadata": "full", "attachments": "full" }
    },
    "pdf_scanned": {
      "short": "Scanned PDF", "label": "Scanned PDF", "ext": [".pdf"], "roles": ["source"], "transit": true, "detected": true,
      "note": "Any PDF or PDF/A whose pages are images without a text layer. Detected per page at load time; routes below apply to those pages.",
      "caps": { "text": "partial", "fonts": "none", "images": "full", "vector": "none", "tables": "partial", "merged_cells": "partial", "formulas": "none", "number_formats": "none", "hyperlinks": "partial", "bookmarks": "full", "headers_footers": "partial", "footnotes": "partial", "slide_notes": "none", "metadata": "full", "attachments": "full" }
    },
