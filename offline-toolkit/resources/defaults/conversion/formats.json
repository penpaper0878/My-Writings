      "caps": { "text": "full", "fonts": "full", "images": "full", "vector": "full", "tables": "partial", "merged_cells": "partial", "formulas": "none", "number_formats": "partial", "hyperlinks": "full", "bookmarks": "full", "headers_footers": "partial", "footnotes": "partial", "slide_notes": "partial", "metadata": "full", "attachments": "none" }
    },
